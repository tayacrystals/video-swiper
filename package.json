{
  "name": "video-swiper",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "jszip": "^3.10.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
